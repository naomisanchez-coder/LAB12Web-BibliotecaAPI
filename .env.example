# Supabase lab12-biblioteca-api: sustituir los marcadores por datos del panel Connect.
# Aplicación: pooler de sesión (puerto 5432).
DATABASE_URL="postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require"
# Administración: conexión directa; requiere red compatible con el host.
DIRECT_URL="postgresql://postgres:URL_ENCODED_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"
