# Conexión Session pooler de Supabase (parámetros del panel Connect).
DATABASE_URL="postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require"
# Para CLI también puede utilizarse Session pooler, sin exigir host IPv6 directo.
DIRECT_URL="postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require"
