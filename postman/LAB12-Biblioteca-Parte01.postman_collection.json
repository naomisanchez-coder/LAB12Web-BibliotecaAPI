{
  "info": {
    "name": "LAB12 Biblioteca · Parte 01",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar en orden en una base de laboratorio. Captura IDs reales. Crea y elimina los ejemplos del docente; comprobar que no existan previamente."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "authorId",
      "value": ""
    },
    {
      "key": "bookId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Crear autor",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/authors",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Gabriel García Márquez\",\n  \"email\": \"gabo@example.com\",\n  \"nationality\": \"Colombia\",\n  \"birthYear\": 1927,\n  \"bio\": \"Premio Nobel de Literatura 1982\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set('authorId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Listar autores",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/authors"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
